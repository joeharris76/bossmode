{
  "context": "Build on central artifact adoption, Git writer identity, and fenced dispatch. Resolve and validate the live clean writer head, exact tracking and remote branch head, prompt/result correlation, reviewer identity, and evaluator run in one acceptance transaction; then create a Bossmode-owned namespaced retention ref. Decision gate: stop if passing evidence is inferred from terminal output, a prior green PR head, an unlinked evaluator, a branch name without SHA, or the same worker that produced the change.",
  "description": "Add reviewer admission, evaluator linkage, exact accepted-head validation, and durable commit retention as a distinct feature. A passing evaluation must come from an independent identity, apply to the selected finished run and immutable commit SHA, and satisfy current local and remote evidence before a worker or task is accepted.",
  "legacy": {
    "anti_patterns": [
      {
        "dont": "Describe the retention ref as preventing SHA mutation",
        "instead": "Use the ref to preserve reachability until integration or archival",
        "item_id": "bossmode-3b-independent-exact-head-acceptance",
        "why": "Git commit SHAs are already immutable"
      },
      {
        "dont": "Let a worker evaluate its own change",
        "instead": "Require a distinct live reviewer identity and linked evaluator run",
        "item_id": "bossmode-3b-independent-exact-head-acceptance",
        "why": "It defeats the independent evidence gate"
      },
      {
        "dont": "Treat green CI or a prior PR head as current acceptance evidence",
        "instead": "Verify the exact local, tracking, live remote, and evaluated SHA at acceptance time",
        "item_id": "bossmode-3b-independent-exact-head-acceptance",
        "why": "The branch may have advanced"
      }
    ],
