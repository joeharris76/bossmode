{
  "context": "Add one canonical registry retire operation keyed by the immutable registry ID. It fences new work, removes the exact owned scheduler registration, validates zero active or unresolved team resources, creates and verifies a final archive, marks the registry retired, and rejects further operational writes. Decision gate: stop if retirement would unlink the only valid history copy, remove an externally managed scheduler, or proceed while any team closeout is incomplete.",
  "description": "Provide the cleanup counterpart for project-level resources that do not belong to one team, especially scheduler jobs and maintenance registrations. Registry retirement must first prove that all teams, runs, claims, and owned resources are terminal, remove receipt-matched project resources, create a verified final archive, and leave durable history readable rather than deleting control.db in place.",
  "legacy": {
    "anti_patterns": [
      {
        "dont": "Delete control.db as ordinary cleanup",
        "instead": "Create a verified final archive and retire it read-only",
        "item_id": "bossmode-5b-registry-project-teardown",
        "why": "It is the durable audit authority, not an ephemeral worker resource"
      },
      {
        "dont": "Remove a scheduler by label or service name alone",
        "instead": "Match the recorded ownership receipt and live scheduler definition",
        "item_id": "bossmode-5b-registry-project-teardown",
        "why": "The name may identify an externally replaced job"
      },
      {
        "dont": "Retire the registry while a team is waiting_user",
        "instead": "Require all team closeouts and owned resources to reach terminal safe states",
        "item_id": "bossmode-5b-registry-project-teardown",
        "why": "That hides unresolved cleanup or data-preservation work"
      }
    ],
